<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Teal Header Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dash_header"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back, Botir 👋"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Here’s your device overview for today."
                android:textColor="#E0FFFFFF"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_greeting" />

            <ImageView
                android:id="@+id/iv_notif"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_social_circle"
                android:padding="8dp"
                android:src="@android:drawable/ic_popup_reminder"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_greeting"
                app:tint="@color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Main Card 1: Device Status -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_lock_idle_low_battery"
                            app:tint="@color/dash_teal" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/batt_label"
                            android:textColor="@color/dash_grey"
                            android:textSize="10sp"
                            android:maxLines="1" />
                        <TextView
                            android:id="@+id/tv_battery_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="48%"
                            android:textColor="@color/dash_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                        <ProgressBar
                            android:id="@+id/pb_battery"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="40dp"
                            android:layout_height="4dp"
                            android:layout_marginTop="4dp"
                            android:progress="48"
                            android:progressTint="@color/dash_teal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_signal_tower"
                            app:tint="@color/dash_teal" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/online_label"
                            android:textColor="@color/dash_grey"
                            android:textSize="10sp"
                            android:maxLines="1" />
                        <TextView
                            android:id="@+id/tv_connection_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_on"
                            android:textColor="@color/dash_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="@color/dash_teal" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Mode"
                            android:textColor="@color/dash_grey"
                            android:textSize="10sp"
                            android:maxLines="1" />
                        <TextView
                            android:id="@+id/tv_mode_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mon_label"
                            android:textColor="@color/dash_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@android:drawable/ic_btn_speak_now"
                            app:tint="@color/dash_teal" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Acoustic"
                            android:textColor="@color/dash_grey"
                            android:textSize="10sp"
                            android:maxLines="1" />
                        <TextView
                            android:id="@+id/tv_acoustic_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textColor="@color/dash_white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Main Card 2: Environment / Location -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hobart, Tasmania"
                        android:textColor="@color/dash_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friday, 24 May 2024"
                        android:textColor="@color/dash_grey"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_location" />

                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="21:45"
                        android:textColor="@color/dash_teal"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_daynight_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_social_circle"
                        android:backgroundTint="@color/dash_card_secondary"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Nighttime"
                        android:textColor="@color/dash_teal"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_time" />

                    <TextView
                        android:id="@+id/tv_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Weather: Not connected"
                        android:textColor="@color/dash_grey"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_date" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Main Card 3: Latest Detection -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_detection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_last_detection_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Latest Detection"
                        android:textColor="@color/dash_grey"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_detection_placeholder"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/dash_card_secondary"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_last_detection_header"
                        app:shapeAppearanceOverlay="@style/RoundedCornersImage"
                        app:tint="@color/dash_grey" />
                    <!-- TODO: Replace with licensed Masked Owl image from dataset, own photo, or Wikimedia Commons with attribution. -->

                    <TextView
                        android:id="@+id/tv_detection_event"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Masked Owl"
                        android:textColor="@color/dash_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/iv_detection_placeholder"
                        app:layout_constraintTop_toTopOf="@id/iv_detection_placeholder" />

                    <TextView
                        android:id="@+id/tv_detection_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today, 10:30 AM"
                        android:textColor="@color/dash_grey"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@id/tv_detection_event"
                        app:layout_constraintTop_toBottomOf="@id/tv_detection_event" />

                    <TextView
                        android:id="@+id/tv_detection_confidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_social_circle"
                        android:backgroundTint="#1A00BCD4"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="92% Confidence"
                        android:textColor="@color/dash_teal"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@id/tv_detection_event"
                        app:layout_constraintTop_toBottomOf="@id/tv_detection_time" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Small Cards Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/dash_card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dash_divider"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Signal Quality" android:textColor="@color/dash_grey" android:textSize="10sp"/>
                        <TextView android:id="@+id/tv_signal_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Strong (92%)" android:textColor="@color/dash_teal" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/dash_card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/dash_divider"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Environment" android:textColor="@color/dash_grey" android:textSize="10sp"/>
                        <TextView android:id="@+id/tv_env_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good / Low Noise" android:textColor="@color/dash_teal" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Quick Actions Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:text="Quick Actions"
                android:textColor="@color/dash_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_devices"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:text="View Devices"
                        android:textColor="@color/dash_teal"
                        android:textAllCaps="false"
                        app:icon="@android:drawable/ic_menu_sort_by_size"
                        app:iconTint="@color/dash_teal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_map"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:text="Open Map"
                        android:textColor="@color/dash_teal"
                        android:textAllCaps="false"
                        app:icon="@android:drawable/ic_dialog_map"
                        app:iconTint="@color/dash_teal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bluetooth"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:text="Bluetooth"
                        android:textColor="@color/dash_teal"
                        android:textAllCaps="false"
                        app:icon="@android:drawable/stat_sys_data_bluetooth"
                        app:iconTint="@color/dash_teal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_history"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_columnWeight="1"
                        android:text="History"
                        android:textColor="@color/dash_teal"
                        android:textAllCaps="false"
                        app:icon="@android:drawable/ic_menu_recent_history"
                        app:iconTint="@color/dash_teal" />

                </GridLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
