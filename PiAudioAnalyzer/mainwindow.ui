<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1500</width>
    <height>1082</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Acoustic Signal Analyzer</string>
  </property>
  <property name="styleSheet">
   <string>
QMainWindow { background-color: #070B12; }
QWidget#centralwidget { background-color: #070B12; color: #E5E7EB; }
QFrame#sidebarFrame, QFrame#mainFrame { background-color: #0B111A; border: 1px solid #263241; border-radius: 8px; }
QLabel { color: #E5E7EB; }
QLabel#titleLabel { color: #F8FAFC; background-color: transparent; font-size: 22px; font-weight: bold; padding: 8px; }
QGroupBox { background-color: #101826; color: #E5E7EB; border: 1px solid #334155; border-radius: 8px; margin-top: 12px; padding: 8px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; color: #22D3EE; font-weight: bold; }
QPushButton { background-color: #172033; color: #F8FAFC; border: 1px solid #334155; border-radius: 6px; padding: 8px 12px; font-weight: bold; }
QPushButton:hover { background-color: #263241; }
QPushButton#btnUpload, QPushButton#btnAnalyse, QPushButton#btnRefreshDevices { background-color: #0F766E; border-color: #14B8A6; }
QPushButton#btnStartRealtime { background-color: #2563EB; border-color: #60A5FA; }
QPushButton#btnStopRealtime { background-color: #DC2626; border-color: #F87171; }


QLineEdit, QTextEdit, QSpinBox {
    background-color: #060B14;
    color: #E5E7EB;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px;
}

QComboBox {
    background-color: #060B14;
    color: #E5E7EB;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #060B14;
    color: #E5E7EB;
    selection-background-color: #0F766E;
    selection-color: #FFFFFF;
    border: 1px solid #22D3EE;
    outline: 0px;
}


QCheckBox { color: #E5E7EB; font-weight: bold; }
QTabWidget::pane { border: 1px solid #334155; background-color: #0B111A; border-radius: 6px; }
QTabBar::tab { background-color: #172033; color: #CBD5E1; padding: 8px 14px; border: 1px solid #334155; border-top-left-radius: 6px; border-top-right-radius: 6px; }
QTabBar::tab:selected { background-color: #0F172A; color: #FFFFFF; border-bottom: 2px solid #22D3EE; }
QTabBar::tab:hover { background-color: #263241; }
QLabel#lblWaveform, QLabel#lblFFT, QLabel#lblSpectrogram, QLabel#lblRealtimeWaveform, QLabel#lblRealtimeSpectrogram, QLabel#lblRealtimeMelSpectrogram, QLabel#lblRealtimeLogMelSpectrogram, QLabel#lblRealtimeMfccHeatmap, QLabel#lbl3DStftSurface { background-color: #020617; color: #E5E7EB; border: 1px solid #334155; border-radius: 6px; }
QLabel#lblRealtimeStatus, QLabel#lblRealtimeMetrics, QLabel#lblRealtimeMelMetrics, QLabel#lblRealtimeLogMelMetrics, QLabel#lblFeatureModeStatus, QLabel#lbl3DStftMetrics { background-color: #020617; color: #93C5FD; border: 1px solid #334155; border-radius: 6px; padding: 6px; font-weight: bold; }
QPushButton#btnRecord {
    background-color: #B91C1C;
    border-color: #F87171;
    color: white;
}
QPushButton#btnSaveRecording {
    background-color: #0F766E;
    border-color: #14B8A6;
    color: white;
}
QLabel#lblRecordTime {
    background-color: #020617;
    color: #22D3EE;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}
QLabel#lblNoiseThresholdValue,
QLabel#lblNoiseStrengthValue,
QLabel#lblNoiseSmoothingValue {
    color: #22D3EE;
    font-weight: bold;
}
QLabel#lblNoiseReductionPreview {
    background-color: #020617;
    color: #E5E7EB;
    border: 1px solid #334155;
    border-radius: 6px;
}
QLabel#lblNoiseReductionMetrics {
    background-color: #020617;
    color: #93C5FD;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}
QSlider::groove:horizontal {
    height: 6px;
    background: #020617;
    border: 1px solid #334155;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #22D3EE;
    border: 1px solid #67E8F9;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #0F766E;
    border-radius: 3px;
}
QLabel#lblNoiseOriginalSpectrogram,
QLabel#lblNoiseReducedSpectrogram {
    background-color: #020617;
    color: #E5E7EB;
    border: 1px solid #334155;
    border-radius: 6px;
}
QLabel#lblNoiseReductionMetrics {
    background-color: #020617;
    color: #93C5FD;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}
QPushButton#btnRecordClean {
    background-color: #B91C1C;
    border-color: #F87171;
    color: white;
}
QPushButton#btnSaveCleanRecording {
    background-color: #0F766E;
    border-color: #14B8A6;
    color: white;
}
QLabel#lblCleanRecordTime {
    background-color: #020617;
    color: #22D3EE;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}
</string>
